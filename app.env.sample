# Feedbin - RSS Reader
# https://feedbin.com/

# Timezone
TZ=America/New_York

# App secret key (min 32 chars)
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# Database credentials (PostgreSQL)
DB_CREATE_DATABASE_NAME=feedbin
DB_USER_NAME=feedbin
DB_USER_PASS=changeme_db_password

# Single-user mode (true/false)
SINGLE_USER_MODE=false
